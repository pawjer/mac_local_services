# BLE Presence Detector environment configuration
# These variables override settings in config/devices.yaml

# MQTT Configuration
MQTT_HOST=10.9.0.3
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=home/presence
MQTT_QOS=1
MQTT_CLIENT_ID=ble_presence_detector

# Scanner Configuration
SCAN_INTERVAL=5.0
SCAN_DURATION=3.0

# State File
STATE_FILE=state.json

# Logging
LOG_LEVEL=INFO
