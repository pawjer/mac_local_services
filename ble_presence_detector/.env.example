# BLE Presence Detector - Environment Variable Overrides
# Copy this file to /Users/proboszcz/Devel/mac_local_services/env/ble-presence.env
# and customize for your environment.
#
# These variables override settings in config/devices.yaml
# Priority: Environment Variables > YAML Config

# ============================================================================
# MQTT Configuration
# ============================================================================

# MQTT broker hostname or IP address
MQTT_HOST=10.9.0.3

# MQTT broker port (default: 1883)
MQTT_PORT=1883

# MQTT authentication (optional)
# MQTT_USERNAME=your_username
# MQTT_PASSWORD=your_password

# MQTT topic prefix for all messages
MQTT_TOPIC_PREFIX=home/presence

# MQTT Quality of Service (0, 1, or 2)
MQTT_QOS=1

# MQTT client identifier
MQTT_CLIENT_ID=ble_presence_detector

# ============================================================================
# BLE Scanner Configuration
# ============================================================================

# Interval between scan starts (seconds)
SCAN_INTERVAL=5.0

# Duration of each scan (seconds, must be < SCAN_INTERVAL)
SCAN_DURATION=3.0

# ============================================================================
# Application Configuration
# ============================================================================

# State file path (relative to config directory or absolute)
STATE_FILE=state.json

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
