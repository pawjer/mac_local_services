# BLE Presence Detector
# Tracks Bluetooth devices and publishes presence to MQTT
# Publishes to: home/presence/#
# Install: pipx install ./ble_presence_detector

NAME=ble-presence
CMD=ble-presence-detector ble_presence_detector/config/devices.yaml --env-file env/ble-presence.env
WAIT_FOR=tcp:10.9.0.3:1883
ENV_FILE=env/ble-presence.env
